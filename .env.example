# Environment Variables Configuration for Literature Search Skill
# Copy this file to .env.local and fill in your API credentials

# Semantic Scholar API (optional - free tier available without key)
# Get your key from: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_KEY=your_semantic_scholar_api_key_here

# SerpApi (Google Scholar) - required for Google Scholar search
# Get your key from: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# Core API - required for Core open access papers
# Get your key from: https://core.ac.uk/services/api
CORE_API_KEY=your_core_api_key_here

# CNKI (知网) - username and password for 知网研学开放平台
# Register at: http://openx.cnki.net/
CNKI_USERNAME=your_cnki_username_here
CNKI_PASSWORD=your_cnki_password_here

# Baidu Qianfan Academic Search API - required for Baidu Scholar
# Get your key from: https://cloud.baidu.com/doc/qianfan/s/Amh4suh5y
BAIDU_API_KEY=your_baidu_qianfan_api_key_here

# OpenAlex API - optional (free tier available, but API key recommended)
# Get your key from: https://openalex.org/settings/api
OPENALEX_API_KEY=your_openalex_api_key_here